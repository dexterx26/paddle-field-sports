APP_NAME="Paddle Field Sports Center"
APP_ENV=production
APP_KEY=base64:7bHXpMWtvlQSlItIGiTSIJlGMLZ1DK3nKYT5ytixI3g=
APP_DEBUG=false
APP_URL=https://paddle-field-sports.laravel.cloud
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
